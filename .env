APP_PORT=:8080
SECRET_API_KEY=KunciRahasiaServerKokiGo123!

DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teleios

# SQLite file for whatsmeow's WhatsApp session/device store (kept separate
# from MySQL because whatsmeow only officially supports SQLite/Postgres).
WHATSMEOW_DB_PATH=./storage/whatsmeow.db

# Base URL of the Laravel app, used to POST an "incoming WhatsApp message"
# webhook that drives Laravel's "Auto Reply (Kata Kunci)" feature. Signed
# with SECRET_API_KEY above (sent as X-API-KEY) — confirmed to be running
# via `php artisan serve` at this address.
LARAVEL_BASE_URL=http://127.0.0.1:8000
